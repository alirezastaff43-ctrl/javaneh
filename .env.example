# AvalAI OpenAI-compatible endpoint. Keep all API keys server-side.
AVALAI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_BASE_URL=https://api.avalai.ir/v1

# Or use Gemini:
# GEMINI_API_KEY=
# AI_MODEL=gemini-2.5-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Or use OpenRouter:
# OPENROUTER_API_KEY=
# AI_MODEL=google/gemma-4-26b-a4b-it:free
# AI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Binavira speech-to-text. Keep this token server-side.
BINAVIRA_API_TOKEN=