# Docker Compose images. Use mirrors hosted inside Iran for isolated deployments.
NODE_IMAGE=node:22-bookworm-slim
POSTGRES_IMAGE=postgres:16-bookworm
NPM_REGISTRY=https://registry.npmjs.org
APP_PORT=3000

# Database credentials are server-side only. URL-encode special characters in the password.
POSTGRES_DB=javaneh
POSTGRES_USER=javaneh
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://javaneh:replace-with-a-long-random-secret@database:5432/javaneh?schema=public

# Comma-separated exact host[:port] authorities approved for internal providers.
INTERNAL_PROVIDER_ALLOWED_HOSTS=ai.internal.example,speech.internal.example,sms.internal.example
AI_BASE_URL=https://ai.internal.example/v1
AI_MODEL=replace-with-approved-model
AI_API_KEY=

# Optional provider-specific key when AI_BASE_URL is api.avalai.ir.
AVALAI_API_KEY=

# Speech-to-text service. These must be explicitly configured in production.
BINAVIRA_API_BASE_URL=https://speech.internal.example/api
BINAVIRA_FILES_BASE_URL=https://speech.internal.example/files
BINAVIRA_API_TOKEN=

# Auth and SMS. Generate AUTH_OTP_SECRET with at least 32 random bytes.
AUTH_OTP_SECRET=replace-with-at-least-32-random-bytes
SMS_PROVIDER_URL=https://sms.internal.example/v1/messages
SMS_PROVIDER_API_KEY=
# Only for local development without an SMS gateway; never used in production.
AUTH_OTP_DEBUG=true